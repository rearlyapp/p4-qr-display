# Waveshare ESP32-P4-Module-DEV-KIT with ESP32-C6 radio coprocessor.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP32-P4NRW32 in-package PSRAM and display-oriented cache configuration.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_EN=n

# This connected board reports ESP32-P4 rev v1.0. Pre-v3 and v3+ P4 silicon
# are mutually incompatible, so build explicitly for rev 1.x hardware.
# The application is intentionally display-only; touch is not initialized.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_BSP_LCD_TYPE_800_1280_10_1_INCH_A=y
# CONFIG_BSP_LCD_TYPE_720_1280_10_1_INCH_B is not set
CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3

# LVGL 9 UI.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# CONFIG_LV_USE_FONT_COMPRESSED is not set

# The supplied packing-demo origin uses a self-signed direct-origin
# certificate. This matches the reference Supervisor QR sketch and is only
# appropriate until the device endpoint has a trusted certificate.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# USB Type-A connector is used as an OTG host for a HID barcode scanner.
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# P4 <-> C6 radio link: Wi-Fi Remote plus BLE Host on P4 / controller on C6.
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_NIMBLE_TRANSPORT_UART is not set
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_ESP_HOSTED_DFLT_TASK_STACK=4096
CONFIG_ESP_LVGL_ADAPTER_ENABLE_DECODER=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# Keep DHCP DNS paired with the selected Ethernet/Wi-Fi route.
CONFIG_ESP_NETIF_SET_DNS_PER_DEFAULT_NETIF=y
CONFIG_LWIP_MAX_SOCKETS=16
